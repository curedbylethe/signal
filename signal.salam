/*
 * signal - POSIX signal primitives for Salam (2026)
 *
 * Salam: https://github.com/SalamLang/Salam
 *
 * Repository: https://github.com/curedbylethe/signal
 * License: GPL-3.0-or-later
 *
 */

/*
 * Signal: POSIX signal plumbing, extracted from basalam's resize watcher.
 *
 * A terminal reports a resize out of band as SIGWINCH, and waiting for that
 * signal is cheaper than polling the size. This package owns the process-wide
 * half of that job: InstallWinchHandler gives SIGWINCH a disposition,
 * BlockWinch keeps it queued instead of delivering it on an arbitrary thread,
 * and WaitWinch parks a thread until one arrives. Policy is not here: when to
 * start watching and what a wake-up means belong to the caller.
 *
 * The handler is a deliberate no-op. It exists only to keep the disposition
 * away from SIG_DFL: Darwin discards a blocked signal at generation when its
 * disposition is the default, so without an installed handler a self- or
 * terminal-raised SIGWINCH would vanish and sigwait would park forever. The
 * signal number carries no information (SIGWINCH only means "the size may
 * have changed"), so the handler has nothing to record and the caller
 * re-reads the state after every wake-up.
 *
 * Installing is reversible, and one registry owns each signal for the whole
 * process. The first Install for a signal captures the calling thread's
 * current disposition and its signal mask into one zeroed heap block: the
 * first _SIGACTION_SIZE bytes take the struct sigaction the kernel fills in,
 * the next SignalSetSize bytes take the mask read before the install. That
 * block is the canonical snapshot and stays in the registry; every Install
 * returns a caller-owned copy of it, released with mem.Free, so two consumers
 * can both free what they were given and neither holds the canonical.
 * Further installs of the same handler only refcount; an install of a
 * different handler while the signal is owned is refused with null, because a
 * handler that never runs is the silent mismatch this package exists to
 * remove. Restore puts this thread's mask back above one reference and, at
 * the last one, restores the disposition too and frees the canonical snapshot;
 * at zero it re-applies the same state without changing a count, so a
 * repeated Restore is legal.
 * The mask half goes through pthread_sigmask, not sigprocmask, because
 * sigprocmask is process-wide on Darwin and unspecified in a multithreaded
 * process on Linux, so only pthread_sigmask makes "the calling thread's mask"
 * true.
 * Install blocks the signal on the calling thread as its last step, after the
 * disposition is in place: a signal blocked while SIG_DFL is still installed
 * is discarded at generation on Darwin, so the other order loses it.
 *
 * Every POSIX target installs through sigaction, never signal(). Salam has no
 * C struct here, so the struct sigaction is a zeroed byte block written
 * through named offsets, one branch per target: Darwin, Linux, FreeBSD,
 * NetBSD and OpenBSD. FreeBSD is the only target where sa_flags precedes
 * sa_mask. ci/sigaction_offsets.c proves the numbers with _Static_asserts
 * against each platform's real headers and a sigaction round trip. Salam has
 * no BSD port, so the BSD branches are proven by that oracle and reviewed,
 * not compiled. Only SA_RESTART is set, sa_mask stays empty and no restorer
 * is written.
 *
 * Async-signal-safety contract for any handler passed to Install: it runs on
 * the thread that took the signal, and it may call async-signal-safe
 * functions only. No allocation, no locks, no stdio, no calls into the Salam
 * runtime: its allocator, its prints and its data structures are all unsafe
 * there. It may touch only volatile sig_atomic_t, lock-free atomics or
 * read-only data; it must save errno on entry and restore it before
 * returning; and it must not assume this package, or anything else it calls,
 * is reentrant. The no-op below meets the contract by doing nothing.
 *
 * Deliberate non-goals. No handler body: the handler runs on the delivery
 * thread and must stay async-signal-safe. No sigtimedwait (absent on macOS)
 * and no SIGALRM timeouts. Sets are built and edited by libc's sigemptyset,
 * sigfillset, sigaddset, sigdelset and sigismember. On Darwin those names are
 * C macros at signal.h:116-126 shadowing the prototypes at 89-97; the
 * real symbols (_sigemptyset, _sigfillset, _sigaddset, _sigdelset,
 * _sigismember) are ordinary libSystem exports, and a non-C extern binds the
 * symbol rather than expanding the macro. A probe on macOS 27.0.1 arm64
 * measured all five linking and running and sizeof(sigset_t) at 4. The size
 * is not universal: 4 on OpenBSD, 16 on FreeBSD and NetBSD, 128 on Linux.
 * DragonFly has no Salam target, so no build selects a size for it. Windows
 * is a stub surface — there is no SIGWINCH and no sigset_t, so
 * every function is safe to call and WinchSupported reports false so callers
 * can fall back to polling.
 *
 * Three public surfaces. SIGWINCH: WinchSignal, WinchSupported, NewWinchSet,
 * InstallWinchHandler, BlockWinch, WaitWinch, WakeWinch. Disposition: Install,
 * Restore, CurrentMask. Signal sets: SignalSetSize, NewSet, FillSet,
 * AddSignal, DelSignal, IsSignal, Block, Unblock, SetMask.
 */

package signal

// mem is imported only on POSIX. Every use of it lives in the POSIX halves
// of the platform branches below; on Windows those halves are not compiled
// and an import nothing uses is an error (E082), so the import has to go
// away with them. sync goes with it: the registry mutex is POSIX-only.
if not SALAM_OS_WINDOWS:
    import mem
    import sync
end

if not SALAM_OS_WINDOWS:
    extern:
        func sigaction(sig: int, act: void*, old: void*): int
        func pthread_sigmask(how: int, set: void*, old: void*): int
        func sigemptyset(set: void*): int
        func sigfillset(set: void*): int
        func sigaddset(set: void*, sig: int): int
        func sigdelset(set: void*, sig: int): int
        func sigismember(set: void*, sig: int): int
        func sigwait(set: void*, sig: void*): int
        func kill(pid: int, sig: int): int
        func getpid(): int
    end
end

@en "WinchSignal"
/// The SIGWINCH number. It is 28 on macOS and Linux, the only platforms
/// the watch is enabled on.
pub const WinchSignal := 28

@en "WaitArrived"
/// Wait returned a signal from its set: the out-block holds its number.
pub const WaitArrived := 1

@en "WaitTimedOut"
/// A bounded wait expired with nothing queued, so the out-block was not
/// written. Wait never returns it; only a timed wait does.
pub const WaitTimedOut := 0

@en "WaitInvalid"
/// A bad argument, or a platform with no signal support. Nothing was waited
/// on.
pub const WaitInvalid := -1

@en "WaitFailed"
/// The wait itself failed. sigwait reports failure as a positive error number
/// and does not set errno; the out-block is untouched.
pub const WaitFailed := -2

@en "WaitBusy"
/// Another thread in this process already owns the wait. Nothing was waited
/// on, so the caller can retry later instead of splitting the deliveries.
pub const WaitBusy := -3

// sizeof(sigset_t): Darwin sys/_types/_sigset_t.h, OpenBSD sys/signal.h, FreeBSD sys/_sigset.h, NetBSD sys/sigtypes.h, Linux sigset headers.
// MAC and OPENBSD must precede BSD, which also matches them.
if SALAM_OS_WINDOWS:
    @en "SignalSetSize"
    /// 0: signal sets do not exist on Windows, where the set functions are
    /// inert stubs.
    pub const SignalSetSize := 0
else SALAM_OS_MAC:
    @en "SignalSetSize"
    /// 4 bytes, the Darwin sigset_t.
    pub const SignalSetSize := 4
else SALAM_OS_OPENBSD:
    @en "SignalSetSize"
    /// 4 bytes, the OpenBSD sigset_t.
    pub const SignalSetSize := 4
else SALAM_OS_BSD:
    @en "SignalSetSize"
    /// 16 bytes, the FreeBSD and NetBSD sigset_t.
    pub const SignalSetSize := 16
else:
    @en "SignalSetSize"
    /// 128 bytes, the glibc and musl sigset_t.
    pub const SignalSetSize := 128
end

// SIG_BLOCK, SIG_UNBLOCK and SIG_SETMASK: sys/signal.h on Darwin and the
// BSDs, bits/sigaction.h in glibc and musl. The wrong value turns a block
// into an unblock, so each is a named constant.
if SALAM_OS_BSD:
    const _SIG_BLOCK := 1
    const _SIG_UNBLOCK := 2
    const _SIG_SETMASK := 3
else:
    const _SIG_BLOCK := 0
    const _SIG_UNBLOCK := 1
    const _SIG_SETMASK := 2
end

// struct sigaction: sys/signal.h on Darwin, OpenBSD, NetBSD and FreeBSD,
// bits/sigaction.h in glibc and musl. _SA_FLAGS_WORD is the u32 index of the
// flags byte, because the zeroed block is written through typed pointers.
// FreeBSD is the only target that puts sa_flags before sa_mask. MAC, OPENBSD
// and NETBSD must precede BSD, which also matches them, or NetBSD silently
// takes FreeBSD's layout and SA_RESTART lands in its mask.
if SALAM_OS_WINDOWS:
    const _SIGACTION_SIZE := 0 // no sigaction on Windows
    const _SA_FLAGS_WORD := 0
    const _SA_RESTART := 0
else SALAM_OS_MAC:
    const _SIGACTION_SIZE := 16 // sys/signal.h: handler 0, mask 8 (4 B), flags 12
    const _SA_FLAGS_WORD := 3 // u32 index of byte 12
    const _SA_RESTART := 0x0002
else SALAM_OS_OPENBSD:
    const _SIGACTION_SIZE := 16 // sys/signal.h: handler 0, mask 8 (4 B), flags 12
    const _SA_FLAGS_WORD := 3 // u32 index of byte 12
    const _SA_RESTART := 0x0002
else SALAM_OS_NETBSD:
    const _SIGACTION_SIZE := 32 // sys/signal.h: handler 0, mask 8 (16 B), flags 24
    const _SA_FLAGS_WORD := 6 // u32 index of byte 24
    const _SA_RESTART := 0x0002
else SALAM_OS_BSD:
    const _SIGACTION_SIZE := 32 // FreeBSD sys/signal.h: handler 0, flags 8, mask 12 (16 B)
    const _SA_FLAGS_WORD := 2 // u32 index of byte 8
    const _SA_RESTART := 0x0002
else:
    const _SIGACTION_SIZE := 152 // glibc/musl bits/sigaction.h: mask 8-135, flags 136, restorer 144
    const _SA_FLAGS_WORD := 34 // u32 index of byte 136
    const _SA_RESTART := 0x10000000
end

if not SALAM_OS_WINDOWS:
    // One zeroed heap block holds the registry: a header, then one slot per
    // signal number, slot 0 unused. The registry exists so one snapshot per
    // signal is canonical for the whole process; callers never see it.
    //
    // Header: the mutex handle slot at _REG_HDR_MUTEX stays reserved and
    // unused. The live mutex is the package-level _mu, because it has to exist
    // before the first install to serialise the registry allocation itself.
    // The offset is named anyway so stage 03's waiter flag and stage 04's
    // pending set keep the planned numbering. _REG_HDR_SIZE is fixed at
    // 16 + 128, the largest sigset_t, so the slot base is the same everywhere.
    //
    // Slot: refs (i64), handler (u64), canonical prev (void*), then the
    // stage-04 fields, named here so the slot size does not move later.
    const _REG_SLOTS := 128
    const _REG_HDR_MUTEX := 0
    const _REG_HDR_WAITER := 8
    const _REG_HDR_PENDING := 16
    const _REG_HDR_SIZE := 144
    const _REG_SLOT_SIZE := 80
    const _REG_SLOT_REFS := 0
    const _REG_SLOT_HANDLER := 8
    const _REG_SLOT_PREV := 16
    const _REG_SLOT_KQUEUE := 24
    const _REG_SLOT_KEVENT := 32
    const _REG_SLOT_TIMESPEC := 64

    const _HANDLE_SIZE := _SIGACTION_SIZE + SignalSetSize

    // Null until the first Install. Every read and write happens under _mu,
    // except _reg == null itself, which is re-checked under the lock.
    mut _reg := null as void*

    // Serialises Install, Restore and stage 03's waiter claim. Created before
    // main runs, so two threads racing on the first Install cannot each
    // allocate a registry.
    mut _mu := sync.NewMutex()
end

if not SALAM_OS_WINDOWS:
    // The out-block WaitWinch writes into, created on the first call and
    // reused because the wait path may not allocate. Two threads racing that
    // first call can each allocate one and the later pointer wins: a benign
    // one-time double allocation, and no thread reads a block another is
    // writing, because only the claim holder waits.
    mut _winch_out := null as void*
end

if not SALAM_OS_WINDOWS:
    func _winch_noop(_sig: int):
        // Deliberate no-op, kept async-signal-safe. It exists only to
        // give SIGWINCH a non-default disposition; the argument is the
        // signal number and carries no information (see the module
        // comment). The discard keeps the body non-empty as the
        // compiler requires without doing any work.
        _ := _sig
    end
end

if not SALAM_OS_WINDOWS:
    // The slot for sig. The registry exists and sig is in range; both are the
    // caller's check.
    func _slot(sig: int): void*:
        base := (_reg as u64) + (_REG_HDR_SIZE as u64)
        ret (base + ((sig as u64) * (_REG_SLOT_SIZE as u64))) as void*
    end

    // The registry, allocated on the first call. Called under _mu, so the
    // allocation and the pending set are not raced.
    func _registry(): void*:
        if _reg == null:
            _reg = mem.AllocateZeroed((_REG_HDR_SIZE + _REG_SLOTS * _REG_SLOT_SIZE) as u64)
            if _reg == null: ret null end
            // Stage 04 waits on this set, so it is built here: no wait path
            // may allocate.
            _ := sigemptyset(((_reg as u64) + (_REG_HDR_PENDING as u64)) as void*)
        end
        ret _reg
    end

    // Test-and-set on the registry header's waiter flag: one waiter per
    // process, so a second one is told so instead of receiving a silent
    // subset. The lock covers the write only, never the wait itself.
    func _claim_waiter(): bool:
        _ := sync.Lock(_mu)
        // No registry means no Install has run, so there is no flag to take:
        // a program that waits before installing gets no ownership check.
        if _reg == null:
            _ := sync.Unlock(_mu)
            ret true
        end
        flag := (_reg as u64) + (_REG_HDR_WAITER as u64)
        busy := (flag as i32*)[0] != 0
        if not busy:
            (flag as i32*)[0] = 1
        end
        _ := sync.Unlock(_mu)
        ret not busy
    end

    // Clear the claim. Writing 0 when the flag was never taken is harmless.
    func _release_waiter():
        _ := sync.Lock(_mu)
        if _reg != null:
            flag := (_reg as u64) + (_REG_HDR_WAITER as u64)
            (flag as i32*)[0] = 0
        end
        _ := sync.Unlock(_mu)
    end

    // Put a captured disposition and mask back on the calling thread. The
    // disposition goes first: a signal arriving between the two steps must
    // meet the restored handler, not this package's no-op. The mask follows
    // even when that failed, so a failed restore cannot leave the signal both
    // blocked and installed.
    func _put_back(sig: int, handle: void*): bool:
        disposition_ok := sigaction(sig, handle, null) == 0
        mask := ((handle as u64) + (_SIGACTION_SIZE as u64)) as void*
        mask_ok := SetMask(mask)
        ret disposition_ok and mask_ok
    end

    // A caller-owned copy of canonical holding this thread's mask. The
    // sigaction bytes come from the canonical snapshot; the mask is read here,
    // so Restore unblocks the thread that installed.
    func _snapshot_copy(canonical: void*): void*:
        copy := mem.AllocateZeroed(_HANDLE_SIZE as u64)
        if copy == null: ret null end
        mem.Copy(copy, canonical, _SIGACTION_SIZE as u64)
        mask := ((copy as u64) + (_SIGACTION_SIZE as u64)) as void*
        if pthread_sigmask(_SIG_BLOCK, null, mask) != 0:
            mem.Free(copy)
            ret null
        end
        ret copy
    end
end

@en "WinchSupported"
/// True when this process can receive SIGWINCH, i.e. on POSIX. Windows has
/// no SIGWINCH, so the watcher must not start there and callers should poll
/// the terminal size instead.
pub func WinchSupported(): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        ret true
    end
end

@en "NewWinchSet"
/// Allocate a signal set containing SIGWINCH and nothing else. The caller
/// owns the memory and releases it with mem.Free. Returns null on Windows,
/// when the allocation fails, or when SIGWINCH cannot be added.
pub func NewWinchSet(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        set := NewSet()
        if set == null: ret null end
        if not AddSignal(set, WinchSignal):
            mem.Free(set)
            ret null
        end
        ret set
    end
end

@en "InstallWinchHandler"
/// Install the process-wide no-op SIGWINCH handler with SA_RESTART and an
/// empty mask, then block SIGWINCH on the calling thread. Returns the
/// previous disposition and mask, owned by the caller: pass it to Restore, or
/// free it with mem.Free. Null on Windows and when the install fails, in
/// which case nothing is left changed. A no-op on Windows.
pub func InstallWinchHandler(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        ret Install(WinchSignal, &_winch_noop)
    end
end

@en "Install"
/// Capture the calling thread's current disposition for sig and its signal
/// mask, install handler with SA_RESTART and an empty sa_mask, then block sig
/// on the calling thread. A null handler is legal and means SIG_DFL. The first
/// install for a signal does that work and keeps the snapshot in the registry;
/// a later install of the same handler only refcounts it, and a later install
/// of a different handler is refused, because a handler that never runs is a
/// silent mismatch. Returns a caller-owned copy of the snapshot: release it
/// with mem.Free and put the state back with Restore. Null on Windows, when
/// sig is outside the table, when another handler already owns sig, or when a
/// step fails, in which case anything already changed is put back.
pub func Install(sig: int, handler: void*): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        if sig <= 0 or sig >= _REG_SLOTS: ret null end
        _ := sync.Lock(_mu)
        if _registry() == null:
            _ := sync.Unlock(_mu)
            ret null
        end
        slot := _slot(sig)
        refs := (slot as i64*)[0]
        if refs > 0:
            if (slot as u64*)[1] != (handler as u64):
                _ := sync.Unlock(_mu)
                ret null
            end
            // Same handler: this thread's mask in a fresh copy, so both
            // consumers own their handle.
            copy := _snapshot_copy((slot as u64*)[2] as void*)
            if copy == null:
                _ := sync.Unlock(_mu)
                ret null
            end
            (slot as i64*)[0] = refs + 1
            _ := sync.Unlock(_mu)
            ret copy
        end
        // refs == 0: this install does the work and owns the canonical block.
        canonical := mem.AllocateZeroed(_HANDLE_SIZE as u64)
        if canonical == null:
            _ := sync.Unlock(_mu)
            ret null
        end
        // The mask is read before the install and before the block: it is what
        // Restore puts back. set == null only reads the third argument.
        mask := ((canonical as u64) + (_SIGACTION_SIZE as u64)) as void*
        if pthread_sigmask(_SIG_BLOCK, null, mask) != 0:
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        act := mem.AllocateZeroed(_SIGACTION_SIZE as u64)
        if act == null:
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        // The block is zeroed, so sa_mask is empty and the rest is SIG_DFL.
        (act as u64*)[0] = handler as u64
        (act as i32*)[_SA_FLAGS_WORD] = _SA_RESTART
        // The kernel writes the whole previous struct at canonical offset 0.
        installed := sigaction(sig, act, canonical) == 0
        mem.Free(act)
        if not installed:
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        set := NewSet()
        mut blocked := false
        if set != null:
            if AddSignal(set, sig):
                blocked = Block(set)
            end
            mem.Free(set)
        end
        if not blocked:
            // Nothing is recorded yet, so the canonical mask makes the
            // recovery exact and the slot stays at refs == 0.
            _ := _put_back(sig, canonical)
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        copy := mem.AllocateZeroed(_HANDLE_SIZE as u64)
        if copy == null:
            _ := _put_back(sig, canonical)
            mem.Free(canonical)
            _ := sync.Unlock(_mu)
            ret null
        end
        // The canonical mask is the pre-block mask, which is this thread's.
        mem.Copy(copy, canonical, _HANDLE_SIZE as u64)
        (slot as u64*)[1] = handler as u64
        (slot as u64*)[2] = canonical as u64
        (slot as i64*)[0] = 1
        _ := sync.Unlock(_mu)
        ret copy
    end
end

@en "Restore"
/// Put back the state an Install snapshot captured on the same thread,
/// returning whether both steps succeeded. Above one reference only the
/// calling thread's mask goes back, so the disposition stays installed. At the
/// last reference the disposition goes back too and the registry frees its
/// canonical snapshot. At zero references the same state is re-applied without
/// touching a count, so a repeated Restore is legal and succeeds again.
/// Frees nothing the caller owns.
pub func Restore(sig: int, prev: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if sig <= 0 or prev == null: ret false end
        _ := sync.Lock(_mu)
        // Nothing was ever installed, or sig is outside the table: the handle
        // still holds a full snapshot, so it can be re-applied on its own.
        if _reg == null or sig >= _REG_SLOTS:
            _ := sync.Unlock(_mu)
            ret _put_back(sig, prev)
        end
        slot := _slot(sig)
        refs := (slot as i64*)[0]
        if refs > 1:
            (slot as i64*)[0] = refs - 1
            mask := ((prev as u64) + (_SIGACTION_SIZE as u64)) as void*
            ok := SetMask(mask)
            _ := sync.Unlock(_mu)
            ret ok
        end
        if refs == 1:
            (slot as i64*)[0] = 0
            ok := _put_back(sig, prev)
            // refs reached zero, so the canonical snapshot goes; a later
            // install rebuilds it. The caller's copy is untouched.
            mem.Free((slot as u64*)[2] as void*)
            (slot as u64*)[1] = 0
            (slot as u64*)[2] = 0
            _ := sync.Unlock(_mu)
            ret ok
        end
        // refs == 0: idempotent, no count change, nothing to free.
        _ := sync.Unlock(_mu)
        ret _put_back(sig, prev)
    end
end

@en "BlockWinch"
/// Add SIGWINCH to the calling thread's signal mask so the signal is queued
/// for WaitWinch instead of delivered on an arbitrary thread. Threads
/// spawned afterwards inherit the mask, which is what lets one dedicated
/// watcher thread own the wait. False on Windows, when the set could not be
/// built, or when blocking failed.
pub func BlockWinch(): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        set := NewWinchSet()
        if set == null: ret false end
        blocked := Block(set)
        mem.Free(set)
        ret blocked
    end
end

@en "Wait"
/// Block the calling thread until a signal in set is queued, then write its
/// number as an i32 at out[0] and return WaitArrived. The thread must have
/// those signals blocked, as BlockWinch does, so they queue instead of being
/// delivered on an arbitrary thread. The out-block is caller-owned and
/// written on arrival only, so a caller can keep its previous value after any
/// other status. Nothing is allocated here. Returns WaitInvalid for a null set
/// or null out and on Windows, WaitBusy when another thread already waits, and
/// WaitFailed when the wait itself failed. Never returns WaitTimedOut, because
/// it has no bound; one waiter per process, so two consumers cannot silently
/// split the deliveries.
pub func Wait(set: void*, out: void*): int:
    if SALAM_OS_WINDOWS:
        ret WaitInvalid
    else:
        if set == null or out == null: ret WaitInvalid end
        if not _claim_waiter(): ret WaitBusy end
        // The kernel writes the number into the caller's block on success.
        status := sigwait(set, out)
        // Released before any return, so a failed wait does not wedge the
        // claim for the rest of the process.
        _release_waiter()
        if status == 0: ret WaitArrived end
        ret WaitFailed
    end
end

@en "WaitWinch"
/// Block the calling thread until a SIGWINCH is queued, then return its
/// signal number. The set must contain SIGWINCH, as NewWinchSet builds, and
/// the thread must have it blocked, as BlockWinch does. Returns 0 on Windows
/// only, where there is no SIGWINCH; on POSIX the failure statuses are
/// negative, so WaitInvalid replaces the old 0 for a null set, and WaitBusy
/// means another thread already waits.
pub func WaitWinch(set: void*): int:
    if SALAM_OS_WINDOWS:
        ret 0
    else:
        if set == null: ret WaitInvalid end
        if _winch_out == null:
            _winch_out = mem.AllocateZeroed(8 as u64)
            if _winch_out == null: ret WaitFailed end
        end
        status := Wait(set, _winch_out)
        if status != WaitArrived: ret status end
        ret (_winch_out as i32*)[0]
    end
end

@en "WakeWinch"
/// Send SIGWINCH to this process so a thread parked in WaitWinch wakes up.
/// With the signal blocked this only queues it, which is exactly what the
/// watcher consumes; Screen uses it to break the wait when shutting down.
/// False on Windows or when kill failed.
pub func WakeWinch(): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        ret kill(getpid(), WinchSignal) == 0
    end
end

@en "NewSet"
/// Allocate an empty signal set. The caller owns the memory and releases it
/// with mem.Free. Returns null on Windows, where sets do not exist, and when
/// the allocation fails.
pub func NewSet(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        set := mem.AllocateZeroed(SignalSetSize as u64)
        if set == null: ret null end
        // Fails only on a null set, guarded above.
        _ := sigemptyset(set)
        ret set
    end
end

@en "FillSet"
/// Fill set with every signal the platform knows. A no-op when set is null
/// and on Windows.
pub func FillSet(set: void*):
    if SALAM_OS_WINDOWS:
        ret
    else:
        if set == null: ret end
        // Fails only on a null set, guarded above.
        _ := sigfillset(set)
    end
end

@en "AddSignal"
/// Add sig to set, returning false on failure. False when set is null and
/// when sig is not positive: Darwin accepts 0 in sigaddset and Linux
/// rejects it, so both are normalized away. Always false on Windows.
pub func AddSignal(set: void*, sig: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null or sig <= 0: ret false end
        ret sigaddset(set, sig) == 0
    end
end

@en "DelSignal"
/// Remove sig from set, returning false on failure. The guards match
/// AddSignal. Always false on Windows.
pub func DelSignal(set: void*, sig: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null or sig <= 0: ret false end
        ret sigdelset(set, sig) == 0
    end
end

@en "IsSignal"
/// True when sig is in set. False when set is null or sig is not positive;
/// sigismember's -1 error is never treated as membership. Always false on
/// Windows.
pub func IsSignal(set: void*, sig: int): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null or sig <= 0: ret false end
        ret sigismember(set, sig) == 1
    end
end

@en "Block"
/// Add set to the calling thread's signal mask so its signals queue instead
/// of being delivered. False when set is null, on Windows, or when the mask
/// could not be changed.
pub func Block(set: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null: ret false end
        ret pthread_sigmask(_SIG_BLOCK, set, null) == 0
    end
end

@en "Unblock"
/// Remove set from the calling thread's signal mask. False when set is null,
/// on Windows, or when the mask could not be changed.
pub func Unblock(set: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null: ret false end
        ret pthread_sigmask(_SIG_UNBLOCK, set, null) == 0
    end
end

@en "SetMask"
/// Replace the calling thread's signal mask with set. False when set is null,
/// on Windows, or when the mask could not be changed.
pub func SetMask(set: void*): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        if set == null: ret false end
        ret pthread_sigmask(_SIG_SETMASK, set, null) == 0
    end
end

@en "CurrentMask"
/// Allocate a set holding the calling thread's current signal mask. The
/// caller owns the memory and releases it with mem.Free, like every other set
/// in this package. Returns null on Windows and when the mask could not be
/// read.
pub func CurrentMask(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        set := NewSet()
        if set == null: ret null end
        // set == null is what selects "read only"; how is ignored then.
        if pthread_sigmask(_SIG_BLOCK, null, set) != 0:
            mem.Free(set)
            ret null
        end
        ret set
    end
end
