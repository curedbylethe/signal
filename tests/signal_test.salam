 */

// Unit tests for the SIGWINCH primitives. These are headless: they never
// open a terminal, they install the handler, block SIGWINCH, raise it
// against the process itself, and consume it with sigwait. That proves the
// full path Screen relies on, including that a blocked signal raised with a
// non-default disposition is queued and delivered, and that a thread spawned
// after BlockWinch inherits the mask and can own the wait.

import testing
import mem

include "../signal.salam"

// How many SIGWINCHes the watcher thread consumed. Written by the watcher,
// read by main after join (which orders the two), so no locking is needed
// and the assertions stay on the main thread.
mut _thread_hits := 0

func watcher(set: void*):
    if signal.WaitWinch(set) == signal.WinchSignal:
        _thread_hits += 1
    end
end

// Two distinct handlers for the install/restore round trip: the second
// install must report the first one as the previous disposition. The
// discard keeps the body non-empty, as the compiler requires.
func noop_one(_sig: int):
    _ := _sig
end

func noop_two(_sig: int):
    _ := _sig
end

func test_supported():
    // CI runs ubuntu and macos only, both POSIX, so the watch is available.
    testing.AssertTrue(signal.WinchSupported())
end

func test_install_restore():
    // Runs second in main, before anything installs a handler or blocks
    // SIGWINCH, so the first install still sees the default disposition.
    before := signal.CurrentMask()
    testing.AssertNotNil(before)
    prev1 := signal.Install(signal.WinchSignal, &noop_one)
    testing.AssertNotNil(prev1)
    // Offset 0 is the handler word in every POSIX struct sigaction, and the
    // first install's previous disposition was SIG_DFL, whose pointer is 0.
    testing.AssertEqInt64((prev1 as u64*)[0] as i64, 0)
    prev2 := signal.Install(signal.WinchSignal, &noop_two)
    testing.AssertNotNil(prev2)
    // Layout pin: the second handle captured the handler the first install
    // put in place.
    testing.AssertTrue(((prev2 as u64*)[0]) == ((&noop_one) as u64))
    // Most recent install first. Restore frees nothing, so restoring the
    // same handle twice is legal and succeeds again.
    testing.AssertTrue(signal.Restore(signal.WinchSignal, prev2))
    testing.AssertTrue(signal.Restore(signal.WinchSignal, prev1))
    testing.AssertTrue(signal.Restore(signal.WinchSignal, prev1))
    after := signal.CurrentMask()
    testing.AssertNotNil(after)
    // The mask is back to what it was: one blocked candidate, one clean
    // signal, one never touched.
    testing.AssertEqBool(signal.IsSignal(after, signal.WinchSignal), signal.IsSignal(before, signal.WinchSignal))
    testing.AssertEqBool(signal.IsSignal(after, 15), signal.IsSignal(before, 15))
    testing.AssertEqBool(signal.IsSignal(after, 1), signal.IsSignal(before, 1))
    mem.Free(prev2)
    mem.Free(prev1)
    mem.Free(after)
    mem.Free(before)
end

func test_blocked_self_signal_is_consumed():
    signal.InstallWinchHandler()
    set := signal.NewWinchSet()
    testing.AssertTrue(set != null)
    signal.BlockWinch()
    // Handler installed and signal blocked: raise it at the process, then
    // consume it. Mirrors probe 1g.
    signal.WakeWinch()
    testing.AssertEqInt(signal.WaitWinch(set), signal.WinchSignal)
    // A null set must not wait (it would block forever), it returns 0.
    testing.AssertEqInt(signal.WaitWinch(null), 0)
    mem.Free(set)
end

func test_thread_inherits_mask():
    signal.InstallWinchHandler()
    signal.BlockWinch()
    set := signal.NewWinchSet()
    // The watcher is spawned after blocking, so it inherits SIGWINCH in its
    // mask and its sigwait is the one that consumes the signal, not main.
    // Mirrors probe 2b, with a single raise: SIGWINCH is a standard signal
    // and two pending copies coalesce into one, so raising twice before the
    // watcher runs would be a race, not a stronger test.
    h := spawn(watcher, set)
    signal.WakeWinch()
    join(h)
    testing.AssertEqInt(_thread_hits, 1)
    mem.Free(set)
end

func test_set_membership():
    set := signal.NewSet()
    testing.AssertTrue(set != null)
    testing.AssertTrue(not signal.AddSignal(set, 0))
    _ := signal.AddSignal(set, signal.WinchSignal)
    // 15 is SIGTERM on every target.
    _ := signal.AddSignal(set, 15)
    testing.AssertTrue(signal.IsSignal(set, signal.WinchSignal))
    testing.AssertTrue(signal.IsSignal(set, 15))
    // SIGHUP (1) was never added.
    testing.AssertTrue(not signal.IsSignal(set, 1))
    testing.AssertTrue(signal.DelSignal(set, signal.WinchSignal))
    testing.AssertTrue(not signal.IsSignal(set, signal.WinchSignal))
    mem.Free(set)
end

func main:
    test_supported()
    test_install_restore()
    test_blocked_self_signal_is_consumed()
    test_thread_inherits_mask()
    test_set_membership()
    ret testing.Summary()
end
